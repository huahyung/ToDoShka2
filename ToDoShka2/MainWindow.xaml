<Window x:Class="ToDoShka2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ToDoShka2"
        mc:Ignorable="d"
        Title="Авторизация" Height="381" Width="632">
    <Grid Margin="0,0,-48,-72">
        <Grid.Background>
            <ImageBrush ImageSource="/9fc1ce2c2f5e39f1b41d0efeee7f863a.jpg"/>
        </Grid.Background>
        <Rectangle Fill="#FFE9B4B4" Margin="147,65,199,105"/>

        <TextBox x:Name="loginn" HorizontalAlignment="Left" Margin="210,96,0,0" TextWrapping="Wrap"  VerticalAlignment="Top" Width="194" Height="25"/>
        <PasswordBox x:Name="passw"  HorizontalAlignment="Left" Margin="210,148,0,0"  VerticalAlignment="Top" Width="194" Height="24" />
        <Button x:Name="enter_button" Content="Войти" HorizontalAlignment="Left" Margin="203,282,0,0" VerticalAlignment="Top" RenderTransformOrigin="4.561,4.496" Width="218" Click="enter_button_Click"/>
        <Label Content="Password" HorizontalAlignment="Left" Margin="213,126,0,0" VerticalAlignment="Top"/>
        <Label Content="Label" HorizontalAlignment="Left" Margin="213,65,0,0" VerticalAlignment="Top"/>

        <Grid Margin="232,177,284,160">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button x:Name="p1" Grid.Row="0" Grid.Column="0" Click="p1_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/4.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="p2" Grid.Row="0" Grid.Column="1" Click="p2_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/3.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="p3" Grid.Row="1" Grid.Column="0" Click="p3_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/2.png"/>
                </Button.Background>
            </Button>
            <Button x:Name="p4" Grid.Row="1" Grid.Column="1" Click="p4_Click_1">
                <Button.Background>
                    <ImageBrush  ImageSource="/1.png"/>
                </Button.Background>
            </Button>
        </Grid>


    </Grid>
</Window>
